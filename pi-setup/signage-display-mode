#!/bin/sh
# Switch the live display mode. All operations are local and instant.
#
#   signage-display-mode normal
#       Show the original ad + video.
#   signage-display-mode takeover
#       Show the standing "Celebrate on this screen" takeover.
#   signage-display-mode takeover /path/to/custom.png
#       Show a custom takeover image for 30 minutes, then automatically
#       revert to the celebrate image (one-shot timer + per-minute watch
#       backstop, so even a reboot cannot leave it stuck).
#   signage-display-mode takeover --revert
#       Restore the celebrate image immediately (used by the timers).
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo." >&2
  exit 1
fi

SIGNAGE_ROOT=/home/admin/signage
MODE_FILE=/etc/default/signage-mode
CELEBRATE_IMG=/home/admin/signage/celebrate.png
REVERT_UNIT=signage-takeover-revert

trigger_health_email() {
  if ! systemctl start --no-block signage-health-email.service; then
    echo "Warning: could not queue the display confirmation email." >&2
  fi
}

cmd=${1:-}
case "$cmd" in
  normal|takeover) ;;
  *)
    echo "Usage: signage-display-mode normal | takeover [custom-png|--revert]" >&2
    exit 2
    ;;
esac

# A mode change cancels any pending custom-takeover revert.
systemctl stop "$REVERT_UNIT.timer" "$REVERT_UNIT.service" 2>/dev/null || true

cur=$(readlink -f "$SIGNAGE_ROOT/current")

write_mode() {
  if [ -n "${2:-}" ]; then
    printf 'MODE=%s\nTAKEOVER_UNTIL=%s\n' "$1" "$2" > "$MODE_FILE"
  else
    printf 'MODE=%s\n' "$1" > "$MODE_FILE"
  fi
}

if [ "$cmd" = "normal" ]; then
  write_mode normal
  /usr/local/sbin/signage-deploy-files "$cur/normal.html" "$cur/ad.mp4" "mode-normal"
  trigger_health_email
  echo "Normal ad + video active."
  exit 0
fi

# --- takeover ---
arg=${2:-}
takeover_image=$CELEBRATE_IMG
takeover_source=mode-takeover-celebrate
takeover_message='Celebrate takeover active.'
custom_takeover=false

if [ -n "$arg" ] && [ "$arg" != "--revert" ]; then
  if [ ! -s "$arg" ]; then
    echo "Custom image missing or empty: $arg" >&2
    exit 1
  fi
  takeover_image=$arg
  takeover_source=mode-takeover-custom
  takeover_message='Custom takeover active for 30 minutes.'
  custom_takeover=true
elif [ "$arg" = "--revert" ]; then
  takeover_message='Takeover reverted to the celebrate image.'
fi

if [ ! -s "$CELEBRATE_IMG" ]; then
  echo "Celebrate image missing or empty: $CELEBRATE_IMG" >&2
  exit 1
fi

# Build the release with its final image before activation. This keeps the
# release hash accurate and prevents Chromium from briefly loading a stale
# takeover image after the kiosk restarts.
takeover_stage=$(mktemp -d "$SIGNAGE_ROOT/.takeover.XXXXXX")
trap 'rm -rf "$takeover_stage"' EXIT HUP INT TERM
install -m 0644 "$cur/takeover.html" "$takeover_stage/takeover.html"
install -m 0644 "$cur/normal.html" "$takeover_stage/normal.html"
install -m 0644 "$takeover_image" "$takeover_stage/takeover.png"

/usr/local/sbin/signage-deploy-files \
  "$takeover_stage/takeover.html" "$cur/ad.mp4" "$takeover_source"
rm -rf "$takeover_stage"
trap - EXIT HUP INT TERM

if [ "$custom_takeover" = true ]; then
  until=$(( $(date +%s) + 1800 ))
  write_mode takeover "$until"
  # One-shot revert in 30 minutes (lost on reboot; the per-minute
  # signage-takeover-watch timer is the backstop).
  systemd-run --on-active=30min --unit="$REVERT_UNIT" \
    /usr/local/sbin/signage-display-mode takeover --revert
else
  write_mode takeover
fi

trigger_health_email
echo "$takeover_message"
