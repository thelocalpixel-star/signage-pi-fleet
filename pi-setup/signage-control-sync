#!/usr/bin/python3
"""Poll the control panel once, execute queued work, and report Pi health."""

import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
import urllib.error
import urllib.request
import uuid
from pathlib import Path

CONFIG = Path("/etc/signage-control.conf")
SIGNAGE_ROOT = Path("/home/admin/signage")
COMMAND_STATE = Path("/var/lib/signage-control/command-results.json")
# Screenshots are the dominant Vercel Blob bandwidth cost. Only upload one
# every N sync runs (each run is ~1 minute) instead of every run.
SCREENSHOT_EVERY_N_RUNS = 30
SCREENSHOT_COUNTER = Path("/var/lib/signage-control/screenshot-counter")


def read_config(path):
    values = {}
    if not path.exists():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def request_json(url, token, method="GET", data=None, headers=None, timeout=60):
    request_headers = {"Authorization": f"Bearer {token}", **(headers or {})}
    request = urllib.request.Request(url, data=data, method=method, headers=request_headers)
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def run(*args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)


def load_command_results():
    try:
        value = json.loads(COMMAND_STATE.read_text(encoding="utf-8"))
        return value if isinstance(value, list) else []
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def save_command_results(results):
    COMMAND_STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = COMMAND_STATE.with_suffix(".tmp")
    temporary.write_text(json.dumps(results[-100:]), encoding="utf-8")
    temporary.chmod(0o600)
    os.replace(temporary, COMMAND_STATE)


def download_media(media, destination):
    expected_size = int(media["size_bytes"])
    digest = hashlib.sha256()
    request = urllib.request.Request(media["url"])
    with urllib.request.urlopen(request, timeout=600) as response, destination.open("wb") as output:
        while True:
            chunk = response.read(1024 * 1024)
            if not chunk:
                break
            output.write(chunk)
            digest.update(chunk)
    if destination.stat().st_size != expected_size:
        raise RuntimeError("downloaded media size did not match the manifest")
    if digest.hexdigest() != media["sha256"]:
        raise RuntimeError("downloaded media checksum did not match the manifest")


def active_mode():
    values = read_config(Path("/etc/default/signage-mode"))
    return values.get("MODE", "normal")


def apply_schedule(payload):
    start = str(payload.get("start", ""))
    stop = str(payload.get("stop", ""))
    timezone = str(payload.get("timezone", ""))
    enabled = payload.get("enabled") is True
    time_pattern = re.compile(r"^(?:[01][0-9]|2[0-3]):[0-5][0-9]$")
    if not time_pattern.match(start) or not time_pattern.match(stop):
        raise RuntimeError("invalid schedule time")
    if timezone != "America/New_York":
        raise RuntimeError("unsupported device time zone")
    path = Path("/etc/default/signage-schedule")
    temporary = path.with_suffix(".tmp")
    temporary.write_text(f"# Times use the Raspberry Pi's local 24-hour clock.\nSTART_TIME={start}\nSTOP_TIME={stop}\n", encoding="utf-8")
    temporary.chmod(0o644)
    os.replace(temporary, path)
    if enabled:
        run("systemctl", "enable", "--now", "signage-schedule.timer")
        run("/usr/local/sbin/signage-schedule")
    else:
        run("systemctl", "disable", "--now", "signage-schedule.timer")


def apply_media(media):
    current = Path(os.path.realpath(SIGNAGE_ROOT / "current"))
    if not current.is_dir():
        raise RuntimeError("active signage release is missing")
    with tempfile.TemporaryDirectory(prefix="signage-control-") as work:
        bundle = Path(work) / "bundle"
        shutil.copytree(current, bundle)
        kind = media["kind"]
        target = bundle / ("ad.mp4" if kind == "ad" else "takeover.png")
        download_media(media, target)
        page = bundle / ("takeover.html" if active_mode() == "takeover" else "normal.html")
        run("/usr/local/sbin/signage-deploy-files", str(page), str(bundle / "ad.mp4"), f"control-{media['id'][:12]}")
        if kind == "takeover":
            run("/usr/local/sbin/signage-display-mode", "takeover", str(target))


def should_capture_screenshot(force):
    """True at most once every SCREENSHOT_EVERY_N_RUNS runs, or when forced.

    Falls back to capturing (previous behavior) if the counter file cannot be
    read or written, so a disk problem never silently kills visibility.
    """
    if force:
        return True
    try:
        count = int(SCREENSHOT_COUNTER.read_text(encoding="utf-8").strip() or "0")
    except (FileNotFoundError, ValueError):
        count = 0
    count += 1
    try:
        SCREENSHOT_COUNTER.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        SCREENSHOT_COUNTER.write_text(str(count), encoding="utf-8")
    except OSError:
        return True
    return count % SCREENSHOT_EVERY_N_RUNS == 0


def capture_screen(destination):
    runtime = Path("/run/user/1000")
    sockets = sorted(runtime.glob("wayland-*")) if runtime.exists() else []
    sockets = [path for path in sockets if path.is_socket()]
    if not sockets:
        return False
    result = run(
        "runuser", "-u", "admin", "--", "env",
        "XDG_RUNTIME_DIR=/run/user/1000",
        f"WAYLAND_DISPLAY={sockets[0].name}",
        "grim", str(destination), check=False,
    )
    return result.returncode == 0 and destination.exists() and destination.stat().st_size > 0


def command_output(*args):
    result = run(*args, check=False)
    return result.stdout.strip() or result.stderr.strip()


def health_snapshot():
    memory = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        key, value = line.split(":", 1)
        memory[key] = int(value.strip().split()[0])
    total = memory.get("MemTotal", 0)
    available = memory.get("MemAvailable", 0)
    swap_used = memory.get("SwapTotal", 0) - memory.get("SwapFree", 0)
    disk = shutil.disk_usage("/")
    chromium = command_output("sh", "-c", "ps -C chromium -o rss= 2>/dev/null | awk '{s+=$1;n++} END {print s+0, n+0}'").split()
    current = Path(os.path.realpath(SIGNAGE_ROOT / "current"))
    return {
        "uptimeSeconds": float(Path("/proc/uptime").read_text().split()[0]),
        "cpuLoad": Path("/proc/loadavg").read_text().split()[:3],
        "memoryTotalBytes": total * 1024,
        "memoryUsedBytes": (total - available) * 1024,
        "memoryUsedPercent": round(((total - available) / total) * 100) if total else 0,
        "swapUsedBytes": swap_used * 1024,
        "diskTotalBytes": disk.total,
        "diskUsedBytes": disk.used,
        "diskUsedPercent": round((disk.used / disk.total) * 100) if disk.total else 0,
        "chromiumRssBytes": int(chromium[0]) * 1024 if chromium else 0,
        "chromiumProcesses": int(chromium[1]) if len(chromium) > 1 else 0,
        "temperature": command_output("vcgencmd", "measure_temp"),
        "throttled": command_output("vcgencmd", "get_throttled"),
        "resolution": command_output("sh", "-c", "wlr-randr 2>/dev/null | awk '/current/ {print $1 \" / \" $2 \" \" $3; exit}'"),
        "currentRelease": current.name if current.is_dir() else "unavailable",
        "mode": active_mode(),
        "commandResults": [],
    }


def multipart_body(fields, file_path=None):
    boundary = f"signage-{uuid.uuid4().hex}"
    parts = []
    for name, value in fields.items():
        parts.extend([
            f"--{boundary}\r\n".encode(),
            f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode(),
            value.encode(), b"\r\n",
        ])
    if file_path and file_path.exists():
        parts.extend([
            f"--{boundary}\r\n".encode(),
            b'Content-Disposition: form-data; name="screenshot"; filename="capture.png"\r\n',
            b"Content-Type: image/png\r\n\r\n",
            file_path.read_bytes(), b"\r\n",
        ])
    parts.append(f"--{boundary}--\r\n".encode())
    return boundary, b"".join(parts)


def main():
    config = read_config(CONFIG)
    base_url = config.get("API_BASE_URL", "").rstrip("/")
    location = config.get("LOCATION_ID", "")
    token = config.get("DEVICE_TOKEN", "")
    if not base_url or not location or not token:
        raise SystemExit(f"Control panel is not configured in {CONFIG}")

    poll = request_json(f"{base_url}/api/device/{location}/poll", token)
    command_results = load_command_results()
    known_results = {result.get("id") for result in command_results}
    media_by_id = {item["id"]: item for item in poll.get("media", [])}
    force_capture = False
    for command in poll.get("commands", []):
        if command.get("id") in known_results:
            continue
        command_type = command.get("type")
        payload = command.get("payload") or {}
        try:
            if command_type == "apply-media":
                media = media_by_id.get(payload.get("releaseId"))
                if not media:
                    raise RuntimeError("assigned media is missing from the device manifest")
                apply_media(media)
            elif command_type == "set-mode":
                mode = payload.get("mode")
                if mode not in ("normal", "takeover"):
                    raise RuntimeError("invalid display mode command")
                run("/usr/local/sbin/signage-display-mode", mode)
            elif command_type == "capture-now":
                force_capture = True
            elif command_type == "send-health-email":
                run("systemctl", "start", "signage-health-email.service")
            elif command_type == "save-schedule":
                apply_schedule(payload)
            else:
                raise RuntimeError("unsupported command")
            result = {"id": command["id"], "status": "completed", "result": "ok"}
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            result = {"id": command["id"], "status": "failed", "result": str(error)[:500]}
        command_results.append(result)
        known_results.add(command["id"])
        save_command_results(command_results)

    health = health_snapshot()
    health["commandResults"] = command_results
    capture = Path(tempfile.gettempdir()) / f"signage-capture-{os.getpid()}.png"
    want_capture = bool(force_capture or health["chromiumProcesses"])
    has_capture = capture_screen(capture) if (want_capture and should_capture_screenshot(force_capture)) else False
    try:
        boundary, body = multipart_body({"health": json.dumps(health)}, capture if has_capture else None)
        request_json(
            f"{base_url}/api/device/{location}/report", token, method="POST", data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}, timeout=90,
        )
        save_command_results([])
    finally:
        capture.unlink(missing_ok=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, urllib.error.URLError) as error:
        raise SystemExit(f"signage-control-sync: {error}")
